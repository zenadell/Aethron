# migration projects are user data, not source
projects/

# design cards derive from the user's projects — user data too
library/

# python
__pycache__/
*.pyc

# per-project history/snapshots live inside projects/ but belt-and-braces
.history/

# OS noise
.DS_Store

# cloud dry-run telemetry log
events.jsonl

# desktop build output
build/
dist/

# local dev context (agent session memory + harness config) — not product code
.claude/

# baked cloud keys (per-developer, never committed)
aethron_config.json

# admin console secrets (service_role, netlify token) — never commit
aethron_admin_config.json
aethron_keys.json

# login sessions (holds access tokens — never commit)
.sessions.json
.aethron-release-key
# AETHRON.md is TRACKED on purpose — it is the project's memory
# and one careless overwrite already cost 105KB of it.
.aethron_ocr

# full output of suites that failed in the last run_all
tests/.last-failures/
